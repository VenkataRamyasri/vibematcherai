# Performance Analysis
def benchmark_latency():
    query = "urban chic style"
    times = []
    
    for _ in range(5):
        start_time = time.time()
        find_similar_products(query)
        end_time = time.time()
        times.append(end_time - start_time)
    
    avg_time = np.mean(times)
    print(f"Average latency over 5 runs: {avg_time:.3f} seconds")
