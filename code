# Visualization
def plot_similarity_scores(results_dict):
    fig, axes = plt.subplots(1, len(results_dict), figsize=(15, 5))
    
    if len(results_dict) == 1:
        axes = [axes]
    
    for idx, (query, matches) in enumerate(results_dict.items()):
        if len(matches) > 0:
            axes[idx].barh(matches['product'], matches['similarity_score'])
            axes[idx].set_title(f"Query: {query[:20]}...")
            axes[idx].set_xlabel('Similarity Score')
            axes[idx].axvline(x=0.7, color='r', linestyle='--', alpha=0.7, label='Threshold (0.7)')
            axes[idx].set_xlim(0, 1)
    
    plt.tight_layout()
    plt.show()

plot_similarity_scores(results)
