# Evaluate system performance
def evaluate_system(results_dict):
    """Evaluate system performance"""
    total_matches = 0
    good_matches = 0
    all_scores = []
    
    for query, matches in results_dict.items():
        if len(matches) > 0:  # Only process if we have matches
            total_matches += len(matches)
            good_matches += len(matches[matches['similarity_score'] > 0.7])
            all_scores.extend(matches['similarity_score'].tolist())
    
    print("📊 System Evaluation:")
    print(f"Total matches found: {total_matches}")
    print(f"Good matches (score > 0.7): {good_matches}")
    if total_matches > 0:
        print(f"Good match rate: {good_matches/total_matches*100:.1f}%")
        print(f"Average similarity score: {np.mean(all_scores):.3f}")

