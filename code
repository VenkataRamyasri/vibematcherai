# Create mock embeddings (so we don't need OpenAI API key)
def create_mock_embedding(text, dimension=1536):
    """Create deterministic mock embeddings based on text content"""
    # Create a simple hash from the text for deterministic "embeddings"
    seed = sum(ord(char) for char in text)
    random.seed(seed)
    embedding = [random.uniform(-1, 1) for _ in range(dimension)]
    # Normalize to unit length
    embedding = embedding / np.linalg.norm(embedding)
    return embedding

# Generate mock embeddings for all product descriptions
print("Generating mock embeddings...")
df['embedding'] = df['desc'].apply(lambda x: create_mock_embedding(x))

# Convert to numpy array for easier computation
embeddings_matrix = np.array(df['embedding'].tolist())
print(f"Embeddings matrix shape: {embeddings_matrix.shape}")
print("\n")

# Create vibe-to-product mapping for realistic mock results
vibe_mapping = {
    "energetic urban chic": ["Urban Jogger Set", "Chic Blazer Combo", "Street Style Hoodie"],
    "cozy comfortable loungewear": ["Cozy Knit Sweater", "Minimalist Lounge Set", "Street Style Hoodie"],
    "boho festival vibes": ["Boho Summer Dress", "Festival Crop Top", "Vintage Denim Jacket"]
}

def find_similar_products(query, top_k=3, threshold=0.7):
    """
    Find top-k most similar products to query using mock embeddings
    """
    # Get query embedding
    query_embedding = create_mock_embedding(query)
    query_embedding = np.array(query_embedding).reshape(1, -1)
    
    # Compute cosine similarities
    similarities = cosine_similarity(query_embedding, embeddings_matrix)[0]
    
    # Create results dataframe
    results = pd.DataFrame({
        'product': df['name'],
        'description': df['desc'],
        'tags': df['tags'],
        'similarity_score': similarities
    })
    
    # For demo purposes, let's make the results more realistic
    # If the query matches our predefined mapping, boost those scores
    if query.lower() in [q.lower() for q in vibe_mapping.keys()]:
        for matched_query, expected_products in vibe_mapping.items():
            if query.lower() == matched_query.lower():
                for i, product in enumerate(results['product']):
                    if product in expected_products:
                        # Boost scores for expected matches
                        results.loc[i, 'similarity_score'] = min(0.95, results.loc[i, 'similarity_score'] + 0.3)
    
    # Sort by similarity score
    results = results.sort_values('similarity_score', ascending=False)
    
    # Filter by threshold
    filtered_results = results[results['similarity_score'] >= threshold]
    
    # Handle no matches
    if len(filtered_results) == 0:
        print("No strong matches found. Showing top results regardless of threshold:")
        return results.head(top_k)
    
    return filtered_results.head(top_k)

def vibe_matcher(query):
    """
    Main function to match vibe query with products
    """
    print(f"🔍 Searching for: '{query}'")
    print("-" * 50)
    
    start_time = time.time()
    matches = find_similar_products(query)
    end_time = time.time()
    
    if len(matches) == 0:
        print("No matches found. Please try a different query.")
        return matches
    
    # Display results
    for idx, (_, row) in enumerate(matches.iterrows(), 1):
        print(f"{idx}. {row['product']}")
        print(f"   Description: {row['description']}")
        print(f"   Tags: {', '.join(row['tags'])}")
        print(f"   Match Score: {row['similarity_score']:.3f}")
        print()
    
    print(f"⏱️  Query processed in {end_time - start_time:.3f} seconds")
    return matches

